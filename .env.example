# Admin Dashboard
ADMIN_PASSWORD=change-me-to-a-strong-password

# Contact Details
CONTACT_EMAIL=contact@vinamrakumar.com
CONTACT_PHONE=+41 76 326 31 55

# Database — SQLite (file path inside the container)
# The compose.yaml already hardcodes this; only override if running locally.
DATABASE_URL=file:/app/data/portfolio.db

# Optional: bring your own SMTP server (e.g. Synology MailPlus).
# Leave unset to use the built-in Google fallback.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=465
# SMTP_USER=your-email@example.com
# SMTP_PASS=your-password

# -- Contact notifications ----------------------------------------------
# ntfy is the primary channel. NTFY_URL defaults to the internal service
# name, so normally only the topic and token need setting in Dockhand.
NTFY_TOPIC=
NTFY_TOKEN=
NTFY_BASE_URL=https://ntfy.vinamrakumar.com
NTFY_CLICK_URL=https://vinamrakumar.com/admin

# Optional second channel. All three of HOST/USER/PASS must be set or SMTP
# is skipped entirely -- that silent skip is why no email ever arrived.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# ── Newsletter (Insights) — see NEWSLETTER_SETUP.md ──────────────────────────
# The subscribe form appears only when the first five are all set.
NEWSLETTER_SMTP_HOST=smtp.protonmail.ch
NEWSLETTER_SMTP_USER=insights@vinamrakumar.com
NEWSLETTER_SMTP_PASS=
NEWSLETTER_FROM="Vinamra Kumar <insights@vinamrakumar.com>"
NEWSLETTER_PROCESSOR="Proton AG (Proton Mail, Switzerland)"
NEWSLETTER_SMTP_PORT=587
NEWSLETTER_REPLY_TO=
NEWSLETTER_TEST_TO=
NEWSLETTER_SEND_INTERVAL_MS=5000
PUBLIC_URL=https://vinamrakumar.com
