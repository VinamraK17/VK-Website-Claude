# Admin Dashboard
ADMIN_PASSWORD=change-me-to-a-strong-password

# Contact Details
CONTACT_EMAIL=contact@vinamrakumar.com
CONTACT_PHONE=+41 76 326 31 55

# Database — SQLite (file path inside the container)
# The compose.yaml already hardcodes this; only override if running locally.
DATABASE_URL=file:/app/data/portfolio.db

# Optional: bring your own SMTP server (e.g. Synology MailPlus).
# Leave unset to use the built-in Google fallback.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=465
# SMTP_USER=your-email@example.com
# SMTP_PASS=your-password
