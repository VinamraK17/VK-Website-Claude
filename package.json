{
  "name": "vk-portfolio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "npm run build:assets && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "test": "node --test tests/**/*.test.mjs",
    "build:css": "tailwindcss -c tailwind.config.js -i src/tailwind.input.css -o public/tailwind.css --minify && node scripts/build-css.mjs",
    "build:icons": "node scripts/build-icons.mjs",
    "build:assets": "npm run build:css && npm run build:icons"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "googleapis": "^171.4.0",
    "lucide": "^0.424.0",
    "nodemailer": "^8.0.7",
    "prisma": "^5.22.0",
    "ua-parser-js": "^1.0.40"
  },
  "devDependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "esbuild": "^0.25.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2"
  }
}
