// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  // node:20-slim is Debian Bookworm (OpenSSL 3.0). Pinning the target ensures
  // Prisma bundles the correct engine binary at build time instead of trying
  // to download it at container startup — prevents the "exit code 1" build failure.
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Message {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  message   String
  createdAt DateTime @default(now())

  // Notification delivery, so the admin console can show what actually reached
  // Vin rather than leaving failures invisible in container logs.
  notified    Boolean   @default(false)
  notifiedAt  DateTime?
  notifyVia   String?
  notifyError String?
}

model Analytics {
  id           Int      @id @default(autoincrement())
  event        String
  details      String
  sessionId    String?
  country      String?
  deviceType   String?
  deviceVendor String?
  browser      String?
  os           String?
  referrer     String?
  createdAt    DateTime @default(now())

  @@index([sessionId])
  @@index([event])
}

model Project {
  id          Int    @id @default(autoincrement())
  title       String
  tag         String
  stats       String
  image       String
  description String
  order       Int    @default(0)
}

model Experience {
  id           Int    @id @default(autoincrement())
  company      String
  role         String
  period       String
  location     String
  description  String
  achievements String // JSON array stored as text — SQLite connector does not support the Json type
  order        Int    @default(0)
}

// ── Newsletter (Insights) ───────────────────────────────────────────────────
// Double opt-in: a row starts as "pending" and only receives issues once the
// confirmation link is used. Unconfirmed rows are deleted after 7 days and
// unsubscribed rows after 30 (see lib/newsletter.ts, RETENTION).
model Subscriber {
  id             Int       @id @default(autoincrement())
  email          String    @unique // stored lower-case
  status         String    @default("pending") // pending | confirmed | unsubscribed
  source         String? // where the form was: "insights" or "issue:<slug>"
  consentVersion String // which wording of the consent text was shown
  requestedAt    DateTime  @default(now())
  confirmedAt    DateTime? // the moment consent was given
  unsubscribedAt DateTime?
  confirmToken   String    @unique
  unsubToken     String    @unique

  deliveries NewsletterDelivery[]

  @@index([status])
}

// One row per issue per subscriber, so a resumed or repeated send never
// emails anyone twice.
model NewsletterDelivery {
  id           Int        @id @default(autoincrement())
  subscriberId Int
  slug         String
  ok           Boolean
  error        String?
  sentAt       DateTime   @default(now())
  subscriber   Subscriber @relation(fields: [subscriberId], references: [id], onDelete: Cascade)

  @@unique([subscriberId, slug])
  @@index([slug])
}

// Optional "why did you leave?" answer. Deliberately not linked to the
// subscriber: the token only lets the person who just unsubscribed answer once.
model UnsubscribeFeedback {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  reason    String?
  comment   String?
  createdAt DateTime @default(now())
}
