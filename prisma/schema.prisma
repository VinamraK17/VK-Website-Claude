// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  // node:20-slim is Debian Bookworm (OpenSSL 3.0). Pinning the target ensures
  // Prisma bundles the correct engine binary at build time instead of trying
  // to download it at container startup — prevents the "exit code 1" build failure.
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Message {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  message   String
  createdAt DateTime @default(now())
}

model Analytics {
  id           Int      @id @default(autoincrement())
  event        String
  details      String
  sessionId    String?
  country      String?
  deviceType   String?
  deviceVendor String?
  browser      String?
  os           String?
  referrer     String?
  createdAt    DateTime @default(now())

  @@index([sessionId])
  @@index([event])
}

model Project {
  id          Int    @id @default(autoincrement())
  title       String
  tag         String
  stats       String
  image       String
  description String
  order       Int    @default(0)
}

model Experience {
  id           Int    @id @default(autoincrement())
  company      String
  role         String
  period       String
  location     String
  description  String
  achievements Json   // Prisma 5 serialises Json as TEXT in SQLite — no code changes needed
  order        Int    @default(0)
}
